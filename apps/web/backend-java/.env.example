# Backend Docker / local config example (Vertex AI)
# Copy values into your own env file (e.g. apps/web/backend-java/.env.local) and adjust.

GEMINI_USE_VERTEX_AI=true
GEMINI_PROJECT_ID=happy-happy-karate-soup
GEMINI_LOCATION=us-central1
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Google Identity Services Client ID (for backend ID token verification)
GOOGLE_OAUTH_CLIENT_ID=

# Email verification
APP_WEB_BASE_URL=http://localhost:5173
APP_MAIL_FROM=noreply@happy-happy-karate-soup.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
APP_AUTH_EXPOSE_VERIFICATION_LINK=true

# Optional: enable deterministic local fallback (no AI)
SOUP_LOCAL_FALLBACK_ENABLED=false
