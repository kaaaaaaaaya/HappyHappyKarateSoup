# Cloud Run deploy script config (scripts/deploy_cloudrun.sh)
# Copy to .env and fill in values. Do NOT commit .env.

PROJECT_ID=your-gcp-project
REGION=us-central1
REPO=happy-soup

# Cloud Run service names
SERVICE_API=karate-soup-api
SERVICE_WEB=karate-soup-web

# Cloud SQL (optional but used in deploy script)
INSTANCE_CONNECTION_NAME=your-project:us-central1:your-instance
SPRING_DATASOURCE_URL=jdbc:mysql:///happysoup?cloudSqlInstance=your-project:us-central1:your-instance&socketFactory=com.google.cloud.sql.mysql.SocketFactory
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=changeme

# Vertex AI (recommended)
GEMINI_USE_VERTEX_AI=true
GEMINI_PROJECT_ID=your-gcp-project
GEMINI_LOCATION=us-central1

# App config
APP_GCS_BUCKET_NAME=your-gcs-bucket
APP_GCS_OBJECT_PREFIX=collections
SOUP_LOCAL_FALLBACK_ENABLED=false
APP_CORS_ALLOWED_ORIGINS=https://your-web-origin

# Web build args
VITE_GOOGLE_CLIENT_ID=
